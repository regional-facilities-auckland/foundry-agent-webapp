# Service Principal Credentials for Local Development
# Copy this file to .env.local and fill in your service principal credentials
# 
# To use a service principal instead of Entra ID authentication:
# 1. Create a service principal in Azure AD
# 2. Grant it the necessary permissions for Azure AI Foundry
# 3. Copy this file to .env.local
# 4. Fill in the values below
# 5. The backend will use ClientSecretCredential to authenticate with Azure

# Service Principal credentials (from Azure AD App Registration)
AZURE_CLIENT_ID=your-service-principal-client-id
AZURE_TENANT_ID=your-service-principal-tenant-id
AZURE_CLIENT_SECRET=your-service-principal-secret

# Azure AI Foundry configuration (same as before)
AI_AGENT_ENDPOINT=https://your-project.openai.azure.com/
AI_AGENT_ID=your-agent-id

# Environment
ASPNETCORE_ENVIRONMENT=Development

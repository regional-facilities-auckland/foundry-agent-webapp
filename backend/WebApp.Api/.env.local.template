# Local development backend configuration
# Auth source in Development is Azure CLI / Azure Developer CLI credential chain.
# Run `az login` (or `azd auth login`) before starting the backend.

# Azure AI Foundry project endpoint (APIM front-door)
AI_AGENT_ENDPOINT=https://your-apim-name.azure-api.net/your-api/api/projects/your-project-name
AI_AGENT_ID=your-agent-id

# Required when AI_AGENT_ENDPOINT points to Azure API Management (.azure-api.net)
AI_AGENT_APIM_SUBSCRIPTION_KEY=your-apim-subscription-key

# Environment
ASPNETCORE_ENVIRONMENT=Development
